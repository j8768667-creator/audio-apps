  <script>
    function sortGridAlphabetically() {
      const grid = document.getElementById('appGrid');
      const cards = Array.from(grid.querySelectorAll('.app-card'));
      cards.sort((a, b) => {
        const titleA = a.querySelector('.app-title').textContent.replace(/^-/, '').toLowerCase();
        const titleB = b.querySelector('.app-title').textContent.replace(/^-/, '').toLowerCase();
        return titleA.localeCompare(titleB);
      });
      cards.forEach(card => grid.appendChild(card));
      document.getElementById('appCount').textContent = cards.length;
    }

    function removeCustomApp(folderName, event) {
      event.stopPropagation();
      event.preventDefault();
      if (confirm(`Remove "${folderName}" from menu?`)) {
        let saved = JSON.parse(localStorage.getItem('customAudioApps') || '[]');
        saved = saved.filter(item => item !== folderName);
        localStorage.setItem('customAudioApps', JSON.stringify(saved));
        location.reload();
      }
    }

    function loadSavedApps() {
      const saved = JSON.parse(localStorage.getItem('customAudioApps') || '[]');
      const grid = document.getElementById('appGrid');
      saved.forEach(folderName => {
        const a = document.createElement('a');
        a.href = folderName + '/main-index.html';
        a.className = 'app-card';
        a.innerHTML = `<span class="app-icon">🎵</span><span class="app-title">${folderName}</span><button class="delete-btn" onclick="removeCustomApp('${folderName}', event)">×</button>`;
        grid.appendChild(a);
      });
      sortGridAlphabetically();
    }

    function addCustomApp() {
      const folderName = prompt('Enter exact folder name as shown in Koder sidebar:');
      if (folderName && folderName.trim() !== '') {
        const cleanName = folderName.trim();
        const saved = JSON.parse(localStorage.getItem('customAudioApps') || '[]');
        if (!saved.includes(cleanName)) {
          saved.push(cleanName);
          localStorage.setItem('customAudioApps', JSON.stringify(saved));
          location.reload();
        }
      }
    }

    function filterApps() {
      const term = document.getElementById('searchInput').value.toLowerCase();
      document.querySelectorAll('.app-card').forEach(card => {
        const title = card.querySelector('.app-title').textContent.toLowerCase();
        card.style.display = title.includes(term) ? 'flex' : 'none';
      });
    }

    loadSavedApps();
  </script>
